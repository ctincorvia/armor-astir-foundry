<section class="assets">
	<div class="section-header">
		<h3>Assets ({{assets.length}})</h3>
		<div class="section-header-actions">
			<button type="button" class="entry-list-add icon-add-button" data-list="assets" title="Add Asset" aria-label="Add Asset">+</button>
		</div>
	</div>
	<ol class="entry-list asset-list">
		{{#each assets}}
		<li class="entry-list-item" data-entry-id="{{id}}">
			<div class="entry-list-row">
				<input type="text" class="entry-list-field" data-list="assets" data-entry-id="{{id}}" data-field="name" value="{{name}}" placeholder="Name"/>
				<button type="button" class="entry-list-remove" data-list="assets" data-entry-id="{{id}}" aria-label="Remove asset">✕</button>
			</div>
			<textarea class="entry-list-field" data-list="assets" data-entry-id="{{id}}" data-field="description" placeholder="Brief description…">{{description}}</textarea>
		</li>
		{{/each}}
	</ol>
</section>
