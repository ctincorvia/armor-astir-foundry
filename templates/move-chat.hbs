<div class="armor-astir-move-chat{{#if superseded}} superseded{{/if}}">
	<h3 class="move-name">{{name}}</h3>
	{{#if variableDiceResult}}
	<div class="move-roll-result">
		<span class="move-variable-dice-target">Target: {{target}}</span>
		<span class="move-variable-dice-successes">Successes: {{successCount}}</span>
	</div>
	<ol class="move-dice">
		{{#each dice}}
		<li class="move-die{{#if success}} move-die-success{{/if}}">
			<span class="move-die-face">{{result}}</span>
		</li>
		{{/each}}
	</ol>
	{{#if successPrompt}}
	<div class="move-hold">
		<p class="move-hold-prompt">{{successPrompt}}</p>
		{{{successOptions}}}
	</div>
	{{/if}}
	{{else if tierLabel}}
	<div class="move-roll-result">
		{{#if traitLabel}}<span class="move-trait">+{{traitLabel}}</span>{{/if}}
		{{#if intentLabel}}<span class="move-intent">{{intentLabel}}</span>{{/if}}
		{{#if weaponLabel}}<span class="move-weapon">{{weaponLabel}}{{#if weaponTags}} ({{weaponTags}}){{/if}}</span>{{/if}}
		<span class="move-tier move-tier-{{tier}}">{{tierLabel}}</span>
	</div>
	{{#if conditions}}
	<div class="move-conditions">
		{{#each conditions}}
		<span class="move-condition move-condition-{{key}}">{{label}}</span>
		{{/each}}
	</div>
	{{/if}}
	<ol class="move-dice">
		{{#each dice}}
		<li class="move-die{{#unless kept}} move-die-dropped{{/unless}}{{#if changed}} move-die-changed{{/if}}">
			{{#if changed}}<span class="move-die-original">{{original}}</span>{{/if}}
			<span class="move-die-face">{{result}}</span>
		</li>
		{{/each}}
	</ol>
	{{#if explodedDice}}
	<ol class="move-dice move-dice-exploded">
		{{#each explodedDice}}
		<li class="move-die move-die-exploded{{#if changed}} move-die-changed{{/if}}">
			{{#if changed}}<span class="move-die-original">{{original}}</span>{{/if}}
			<span class="move-die-face">{{result}}</span>
		</li>
		{{/each}}
	</ol>
	{{/if}}
	{{#if beastTriggered}}
	<div class="move-beast-trigger">Number Of The Beast: three 6's rolled — you are killed in a spectacular fashion at the nearest suitable moment. Narrate it with your Director.</div>
	{{/if}}
	{{#if resultText}}
	<div class="move-result-text">{{{resultText}}}</div>
	{{/if}}
	{{#if questions}}
	<div class="move-hold">
		{{#if hold}}<span class="move-hold-count">Hold {{hold}}</span>{{/if}}
		{{#if questionPrompt}}
		<p class="move-hold-prompt">{{questionPrompt}}</p>
		{{/if}}
		<ul class="move-questions">
			{{#each questions}}
			<li>{{this}}</li>
			{{/each}}
		</ul>
	</div>
	{{/if}}
	{{#if reminders}}
	<ul class="move-reminders">
		{{#each reminders}}
		<li>{{this}}</li>
		{{/each}}
	</ul>
	{{/if}}
	{{#if reroll}}
	<button type="button" class="move-reroll">Reroll (Decisive/Defensive/Versatile)</button>
	{{/if}}
	{{#if heatUp}}
	<button type="button" class="move-heatup">Heat Up (Reroll)</button>
	{{/if}}
	{{#each automaticSuccess}}
	<button type="button" class="move-automatic-success" data-source="{{key}}">Automatic success from {{name}}</button>
	{{/each}}
	<div class="move-advantage-controls">
		{{#if showAddAdvantage}}<button type="button" class="move-add-advantage">+Advantage</button>{{/if}}
		{{#if showAddDisadvantage}}<button type="button" class="move-add-disadvantage">+Disadvantage</button>{{/if}}
	</div>
	{{else}}
	<div class="move-description">{{{description}}}</div>
	{{/if}}
</div>
