			<div class="tab" data-group="primary" data-tab="conflict">
				<section class="conflict-scenes">
					<div class="section-header">
						<h3>Conflict Scenes</h3>
					</div>
					<ol class="entry-list conflict-scene-list">
						{{#each conflictScenes}}
						<li class="entry-list-item conflict-scene-item">
							<span class="conflict-scene-name">{{name}}</span>
							<div class="conflict-scene-controls">
								<button type="button" class="conflict-scene-chat move-description" data-scene-key="{{key}}" aria-label="Post {{name}} to chat">Chat</button>
								<button type="button" class="conflict-scene-info move-info" data-scene-key="{{key}}" aria-label="{{name}} details">?</button>
							</div>
						</li>
						{{/each}}
					</ol>
				</section>
			</div>
