					<section class="ardents">
						<div class="section-header">
							<h3>Ardents</h3>
							<div class="section-header-actions">
								<button type="button" class="ardent-create icon-add-button" title="Add an Ardent" aria-label="Add an Ardent">+</button>
							</div>
						</div>
						{{#each ardents}}
						<div class="ardent">
							<div class="section-header">
								<input type="text" class="ardent-name-input" data-ardent-id="{{id}}" value="{{name}}" placeholder="Ardent name…"/>
								<div class="section-header-actions">
									<button type="button" class="ardent-delete icon-add-button" data-ardent-id="{{id}}" title="Delete Ardent" aria-label="Delete Ardent">✕</button>
								</div>
							</div>
							<div class="astir-identity-fields">
								<div class="form-group">
									<label>Approach</label>
									<select class="ardent-approach-select" data-ardent-id="{{id}}">
										{{selectOptions approachOptions selected=approach valueAttr="key" labelAttr="label" blank="— Choose —"}}
									</select>
								</div>
								<div class="equipment-tier-control">
									<button type="button" class="equipment-tier-step ardent-tier-step ardent-tier-decrement" data-ardent-id="{{id}}" data-delta="-1">-</button>
									<span class="equipment-tier-value">Tier {{tier}}</span>
									<button type="button" class="equipment-tier-step ardent-tier-step ardent-tier-increment" data-ardent-id="{{id}}" data-delta="1">+</button>
								</div>
							</div>
							<div class="trait-meters">
								<label class="piloted-label">
									<input type="checkbox" class="ardent-piloted-checkbox" data-ardent-id="{{id}}" {{#if piloted}}checked{{/if}}/>
									Piloted
								</label>
							</div>
							<div class="section-header">
								<h3>Parts</h3>
								{{#unless loadoutFull}}
								<div class="section-header-actions">
									<button type="button" class="ardent-part-add icon-add-button" data-ardent-id="{{id}}" title="Add an Ardent Part" aria-label="Add an Ardent Part">+</button>
								</div>
								{{/unless}}
							</div>
							<ol class="move-list">
								{{#each parts}}
								<li class="move{{#if disabled}} move-disabled{{/if}}">
									<span class="move-name">{{name}}</span>
									<div class="move-row-controls">
										<span class="astir-part-tier">Tier {{tier}}</span>
										<span class="astir-part-type">{{partType}}</span>
										<label class="part-disabled-label">
											<input type="checkbox" class="part-disabled-checkbox" data-part="{{key}}" {{#if disabled}}checked{{/if}}/>
											Disabled
										</label>
										<button type="button" class="ardent-part-remove" data-ardent-id="{{../id}}" data-part="{{key}}" aria-label="Remove Ardent part">✕</button>
									</div>
								</li>
								{{/each}}
							</ol>
							<div class="section-header">
								<h3>Weapons</h3>
								{{#unless loadoutFull}}
								<div class="section-header-actions">
									<button type="button" class="ardent-weapon-catalog-add icon-add-button" data-ardent-id="{{id}}" title="Pick Ardent Weapon from Catalog" aria-label="Pick Ardent Weapon from Catalog">O</button>
								</div>
								{{/unless}}
							</div>
							<ol class="equipment-list">
								{{#each weapons}}
								<li class="equipment-item{{#if disabled}} equipment-item-disabled{{/if}}" data-equipment-id="{{id}}">
									<div class="equipment-header">
										<span class="equipment-name">{{name}}</span>
										<div class="equipment-meta">
											<span class="equipment-value">Value {{value}}</span>
											<span class="equipment-tier-value">Tier {{tier}}</span>
											<span class="equipment-scale">{{scaleLabel}}</span>
										</div>
										<div class="equipment-actions">
											<label class="equipment-disabled">
												<input type="checkbox" class="equipment-disabled-checkbox" data-equipment-id="{{id}}" {{#if disabled}}checked{{/if}}/>
												Disabled
											</label>
											<div class="equipment-item-controls">
												<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
												<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
											</div>
										</div>
									</div>
									{{#if description}}
									<div class="equipment-description">{{description}}</div>
									{{/if}}
									{{#if tags.length}}
									<div class="equipment-tags-block">
										<ul class="equipment-tag-list">
											{{#each tags}}
											<li class="equipment-tag">
												<span class="equipment-tag-label">{{label}}{{#if showValue}} ({{value}}){{/if}}</span>
												{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
												{{#if spendable}}
												<label class="equipment-tag-spent">
													<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
													Spent
												</label>
												{{/if}}
											</li>
											{{/each}}
										</ul>
									</div>
									{{/if}}
									{{#if weaponMoves.length}}
									<div class="weapon-move-controls">
										{{#each weaponMoves}}
										<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled data-gate-tooltip="{{tooltip}}"{{/if}}>{{name}}</button>
										{{/each}}
									</div>
									{{/if}}
								</li>
								{{/each}}
							</ol>
							{{#if ../isCommander}}
							<div class="section-header">
								<h3>Ardent Features ({{featureParts.length}}{{#with featureWeapons}}{{#if length}}+{{length}}{{/if}}{{/with}} / {{featureMax}})</h3>
								{{#unless featureLoadoutFull}}
								<div class="section-header-actions">
									<button type="button" class="ardent-feature-part-add icon-add-button" data-ardent-id="{{id}}" title="Add an Ardent Feature (Part)" aria-label="Add an Ardent Feature (Part)">+</button>
									<button type="button" class="ardent-feature-weapon-add icon-add-button" data-ardent-id="{{id}}" title="Pick an Ardent Feature Weapon from Catalog" aria-label="Pick an Ardent Feature Weapon from Catalog">O</button>
								</div>
								{{/unless}}
							</div>
							<ol class="move-list">
								{{#each featureParts}}
								<li class="move{{#if disabled}} move-disabled{{/if}}">
									<span class="move-name">{{name}}</span>
									<div class="move-row-controls">
										<span class="astir-part-tier">Tier {{tier}}</span>
										<span class="astir-part-type">{{partType}}</span>
										<label class="part-disabled-label">
											<input type="checkbox" class="part-disabled-checkbox" data-part="{{key}}" {{#if disabled}}checked{{/if}}/>
											Disabled
										</label>
										<button type="button" class="ardent-part-remove" data-ardent-id="{{../id}}" data-part="{{key}}" aria-label="Remove Ardent Feature part">✕</button>
									</div>
								</li>
								{{/each}}
							</ol>
							<ol class="equipment-list">
								{{#each featureWeapons}}
								<li class="equipment-item{{#if disabled}} equipment-item-disabled{{/if}}" data-equipment-id="{{id}}">
									<div class="equipment-header">
										<span class="equipment-name">{{name}}</span>
										<div class="equipment-meta">
											<span class="equipment-value">Value {{value}}</span>
											<span class="equipment-tier-value">Tier {{tier}}</span>
											<span class="equipment-scale">{{scaleLabel}}</span>
										</div>
										<div class="equipment-actions">
											<label class="equipment-disabled">
												<input type="checkbox" class="equipment-disabled-checkbox" data-equipment-id="{{id}}" {{#if disabled}}checked{{/if}}/>
												Disabled
											</label>
											<div class="equipment-item-controls">
												<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
												<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
											</div>
										</div>
									</div>
									{{#if description}}
									<div class="equipment-description">{{description}}</div>
									{{/if}}
									{{#if tags.length}}
									<div class="equipment-tags-block">
										<ul class="equipment-tag-list">
											{{#each tags}}
											<li class="equipment-tag">
												<span class="equipment-tag-label">{{label}}{{#if showValue}} ({{value}}){{/if}}</span>
												{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
												{{#if spendable}}
												<label class="equipment-tag-spent">
													<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
													Spent
												</label>
												{{/if}}
											</li>
											{{/each}}
										</ul>
									</div>
									{{/if}}
									{{#if weaponMoves.length}}
									<div class="weapon-move-controls">
										{{#each weaponMoves}}
										<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled data-gate-tooltip="{{tooltip}}"{{/if}}>{{name}}</button>
										{{/each}}
									</div>
									{{/if}}
								</li>
								{{/each}}
							</ol>
							{{/if}}
						</div>
						{{/each}}
					</section>
