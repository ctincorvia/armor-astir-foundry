				<div class="tab" data-group="primary" data-tab="downtime">
					<section class="downtime">
						<section class="downtime-tokens">
							<div class="section-header">
								<h3>Downtime Tokens</h3>
							</div>
							<ol class="downtime-tokens-list">
								<li class="power-control downtime-tokens-control">
									<label class="power-label">Baseline</label>
									<button type="button" class="power-step downtime-tokens-step downtime-tokens-decrement" data-delta="-1">-</button>
									<span class="power-value">{{downtimeTokens.value}} / {{downtimeTokens.max}}</span>
									<button type="button" class="power-step downtime-tokens-step downtime-tokens-increment" data-delta="1">+</button>
								</li>
								{{#each bonusDowntimeTokens}}
								<li class="power-control bonus-downtime-tokens-control">
									<div class="bonus-downtime-tokens-label-column">
										<label class="power-label">{{name}}</label>
										<p class="bonus-downtime-tokens-description">{{description}}</p>
									</div>
									<button type="button" class="power-step bonus-downtime-tokens-step bonus-downtime-tokens-decrement" data-move-key="{{moveKey}}" data-equipment-id="{{equipmentId}}" data-delta="-1">-</button>
									<span class="power-value">{{value}} / {{max}}</span>
									<button type="button" class="power-step bonus-downtime-tokens-step bonus-downtime-tokens-increment" data-move-key="{{moveKey}}" data-equipment-id="{{equipmentId}}" data-delta="1">+</button>
								</li>
								{{/each}}
							</ol>
						</section>
						{{#if downtimeAlly}}
						<div class="power-control downtime-ally-control">
							<label class="power-label">Downtime Ally</label>
							{{#if downtimeAlly.exists}}
							<input type="text" class="downtime-ally-name-input" value="{{downtimeAlly.name}}" placeholder="Ally name"/>
							<button type="button" class="downtime-ally-invest icon-add-button labeled-add-button{{#unless downtimeAlly.canInvest}} disabled{{/unless}}" {{#unless downtimeAlly.canInvest}}disabled{{/unless}} title="Invest 1 Power" aria-label="Invest 1 Power">+1 Power</button>
							<span class="power-value">Power Invested: {{downtimeAlly.powerInvested}}</span>
							<button type="button" class="downtime-ally-release icon-add-button labeled-add-button" aria-label="Release Downtime Ally">Release</button>
							{{else}}
							<button type="button" class="downtime-ally-add icon-add-button labeled-add-button" title="Bind a Downtime Ally" aria-label="Bind a Downtime Ally">+ Bind Downtime Ally</button>
							{{/if}}
						</div>
						{{/if}}
						{{#if downtimeAbilities.length}}
						<section class="downtime-abilities">
							<div class="section-header">
								<h3>Downtime Abilities</h3>
							</div>
							<ol class="entry-list downtime-ability-list">
								{{#each downtimeAbilities}}
								<li class="entry-list-item downtime-ability-item">
									<p class="downtime-ability-description">{{description}}</p>
									<p class="downtime-ability-source">{{name}}</p>
								</li>
								{{/each}}
							</ol>
						</section>
						{{/if}}
						{{#if isWitch}}
						<section class="patron">
							<div class="section-header">
								<h3>Patron</h3>
								<div class="section-header-actions">
									<button type="button" class="witch-boons-random icon-add-button labeled-add-button" title="Two Random Boons" aria-label="Two Random Boons">Two Random Boons</button>
									<button type="button" class="witch-boons-choose icon-add-button labeled-add-button{{#unless witch.canChooseBoons}} disabled{{/unless}}" title="Choose 2 Boons" aria-label="Choose 2 Boons" {{#unless witch.canChooseBoons}}disabled data-gate-tooltip="Requires the Whims move. Pick it in Playbook Moves to choose your boons instead of rolling."{{/unless}}>Choose 2 Boons</button>
									<button type="button" class="witch-boons-relinquish icon-add-button labeled-add-button" title="Relinquish Boons" aria-label="Relinquish Boons">Relinquish Boons</button>
								</div>
							</div>
							<div class="power-control patron-influence">
								<label class="power-label">Influence</label>
								<button type="button" class="power-step witch-influence-step witch-influence-decrement" data-delta="-1">-</button>
								<span class="power-value">{{witch.influence}}</span>
								<button type="button" class="power-step witch-influence-step witch-influence-increment" data-delta="1">+</button>
							</div>
							<ol class="patron-boons-list">
								{{#each witch.boons}}
								<li class="patron-boon-item{{#if held}} held{{/if}}">
									<span class="patron-boon-name">{{name}}</span>
									<p class="patron-boon-description">{{description}}</p>
								</li>
								{{/each}}
							</ol>
						</section>
						{{/if}}
						{{#if isArcanist}}
						<section class="rituals">
							<div class="section-header">
								<h3>Prepare Rituals</h3>
								<div class="section-header-actions">
									<button type="button" class="arcanist-rituals-prepare icon-add-button labeled-add-button" title="Prepare Rituals" aria-label="Prepare Rituals">Prepare</button>
									<button type="button" class="arcanist-rituals-adapt icon-add-button labeled-add-button{{#unless arcanist.canAdapt}} disabled{{/unless}}" title="Adapt Rituals" aria-label="Adapt Rituals" {{#unless arcanist.canAdapt}}disabled data-gate-tooltip="{{arcanist.adaptTooltip}}"{{/unless}}>Adapt</button>
								</div>
							</div>
							<div class="power-control ritual-ward-hold">
								<label class="power-label">Ward Hold</label>
								<span class="power-value">{{arcanist.wardHold}}</span>
							</div>
							<ol class="ritual-slot-list">
								{{#each arcanist.slots}}
								<li class="ritual-slot-item{{#if spent}} spent{{/if}}{{#unless prepared}} empty{{/unless}}">
									<span class="ritual-slot-label">{{label}}</span>
									{{#if prepared}}
									<span class="ritual-slot-name">{{name}}{{#if moveName}} ({{moveName}}){{/if}}</span>
									<p class="ritual-slot-description">{{description}}</p>
									{{#if spent}}<span class="ritual-slot-spent-tag">Spent</span>{{/if}}
									{{else}}
									<span class="ritual-slot-empty-tag">Not prepared</span>
									{{/if}}
								</li>
								{{/each}}
							</ol>
						</section>
						{{/if}}
						<section class="downtime-scenes">
							<div class="section-header">
								<h3>Downtime Scenes</h3>
							</div>
							<ol class="entry-list downtime-scene-list">
								{{#each downtimeSceneKinds}}
								<li class="entry-list-item downtime-scene-item">
									<span class="downtime-scene-name">{{name}}</span>
									<div class="downtime-scene-controls">
										<button type="button" class="downtime-scene-chat move-description" data-scene-kind="{{key}}" aria-label="Post {{name}} to chat">Chat</button>
										<button type="button" class="downtime-scene-info move-info" data-scene-kind="{{key}}" aria-label="{{name}} details">?</button>
									</div>
								</li>
								{{/each}}
							</ol>
						</section>
					</section>
				</div>
