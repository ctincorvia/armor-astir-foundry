						<div class="section-header">
							<h3>Gear</h3>
							<div class="section-header-actions">
								{{#unless equipment.startingGear.available}}
								<button type="button" class="equipment-add icon-add-button" data-kind="gear" title="Add Gear" aria-label="Add Gear">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="gear" title="Pick Gear from Catalog" aria-label="Pick Gear from Catalog">O</button>
								{{/unless}}
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.gear}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<div class="equipment-meta">
										<span class="equipment-value">Value {{value}}</span>
									</div>
									<div class="equipment-actions">
										<div class="equipment-item-controls">
											<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
											<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
										</div>
									</div>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<div class="equipment-tags-block">
									<ul class="equipment-tag-list">
										{{#each tags}}
										<li class="equipment-tag">
											<span class="equipment-tag-label">{{label}}{{#if showValue}} ({{value}}){{/if}}</span>
											{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
											{{#if spendable}}
											<label class="equipment-tag-spent">
												<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
