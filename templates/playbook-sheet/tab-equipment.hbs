				<div class="tab" data-group="primary" data-tab="equipment">
					<section class="equipment">
						<div class="section-header">
							<h3>Weapons</h3>
							<div class="section-header-actions">
								{{#if equipment.startingGear.available}}
								<button type="button" class="starting-gear-add icon-add-button labeled-add-button" title="Choose Starting Gear" aria-label="Choose Starting Gear">+ Starting Equipment</button>
								{{else}}
								<button type="button" class="equipment-add icon-add-button" data-kind="weapon" title="Add Weapon" aria-label="Add Weapon">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="weapon" title="Pick Weapon from Catalog" aria-label="Pick Weapon from Catalog">O</button>
								{{/if}}
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.weapons}}
							{{> "modules/armor-astir/templates/shared/equipment-card.hbs" controls=true disabledToggle=true}}
							{{/each}}
						</ol>
						{{#if equipment.astirWeapons.length}}
						<div class="section-header">
							<h3>Astir Weapons</h3>
						</div>
						<ol class="equipment-list">
							{{#each equipment.astirWeapons}}
							{{> "modules/armor-astir/templates/shared/equipment-card.hbs" disabledToggle=true}}
							{{/each}}
						</ol>
						{{/if}}
						{{#if equipment.ardentWeapons.length}}
						<div class="section-header">
							<h3>Ardent Weapons</h3>
						</div>
						<ol class="equipment-list">
							{{#each equipment.ardentWeapons}}
							{{> "modules/armor-astir/templates/shared/equipment-card.hbs" disabledToggle=true}}
							{{/each}}
						</ol>
						{{/if}}
						<div class="section-header">
							<h3>Gear</h3>
							<div class="section-header-actions">
								{{#unless equipment.startingGear.available}}
								<button type="button" class="equipment-add icon-add-button" data-kind="gear" title="Add Gear" aria-label="Add Gear">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="gear" title="Pick Gear from Catalog" aria-label="Pick Gear from Catalog">O</button>
								{{/unless}}
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.gear}}
							{{> "modules/armor-astir/templates/shared/equipment-card.hbs" controls=true}}
							{{/each}}
						</ol>
						{{#if isSupport}}
						<div class="section-header"><h3>Quarters</h3></div>
						<div class="quarters">
							<input type="text" class="quarters-name-input" value="{{quarters.name}}" placeholder="Quarters name"/>
							<textarea class="quarters-description-input" placeholder="Describe your Quarters, where they are on the ship, and what they provide...">{{quarters.description}}</textarea>
							<ol class="quarters-benefit-list">
								{{#each quarters.benefits}}
								<li class="quarters-benefit-item">
									<label>
										<input type="checkbox" class="quarters-benefit-checkbox" data-benefit="{{key}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}/>
										{{label}}
									</label>
								</li>
								{{/each}}
							</ol>
							{{#if quarters.showCarrierSelect}}
							<div class="quarters-carrier-control">
								<label>Assigned Carrier</label>
								<select class="quarters-carrier-select">
									{{selectOptions quarters.carrierOptions selected=quarters.carrierId valueAttr="id" labelAttr="name" blank="— Unassigned —"}}
								</select>
							</div>
							{{/if}}
						</div>
						{{/if}}
					</section>
				</div>
