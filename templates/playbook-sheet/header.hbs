	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="flex3">
			<div class="form-group">
				<label>Name</label>
				<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
			</div>
			<div class="form-group">
				<label>Callsign</label>
				<input type="text" name="system.details.callsign.value" value="{{data.system.details.callsign.value}}" placeholder="Callsign"/>
			</div>
		</div>
		<div class="playbook-swap">
			<label>Playbook</label>
			<select class="playbook-select" name="playbook">
				{{selectOptions playbooks selected=currentPlaybookId valueAttr="packId" labelAttr="name"}}
			</select>
		</div>
		<div class="approach-swap">
			<label>Approach</label>
			<select name="system.attributes.approach">
				{{selectOptions approachOptions selected=approach.base valueAttr="key" labelAttr="label" blank="— Choose —"}}
			</select>
		</div>
		<div class="tier-readout">
			<label>Tier</label>
			<span class="tier-value">{{tier.effective}}</span>
		</div>
		{{#if tier.fromFrame}}
		<div class="header-derived-note">
			Piloting <strong>{{tier.frameName}}</strong> — Tier {{tier.effective}}{{#if approach.fromFrame}}, Approach {{approach.effectiveLabel}}{{/if}}
		</div>
		{{/if}}
		{{#if approach.fromMove}}
		<div class="header-derived-note">
			Approach {{approach.effectiveLabel}} (from <strong>{{approach.moveName}}</strong>)
		</div>
		{{/if}}
	</header>
