<form class="armor-astir-equipment-editor">
	{{#if note}}
	<p class="equipment-editor-note">{{note}}</p>
	{{/if}}
	<div class="form-group">
		<label>Name</label>
		<input type="text" name="name" value="{{name}}"/>
	</div>
	<div class="form-group">
		<label>Kind</label>
		<select name="kind">
			<option value="weapon" {{#if isWeapon}}selected{{/if}}>Weapon</option>
			<option value="gear" {{#unless isWeapon}}selected{{/unless}}>Gear</option>
		</select>
	</div>
	<div class="form-group equipment-editor-weapon-fields">
		<label>Scale</label>
		<select name="scale">
			{{selectOptions scales selected=scale valueAttr="key" labelAttr="label"}}
		</select>
	</div>
	<div class="form-group equipment-editor-weapon-fields">
		<label>Tier</label>
		<input type="number" name="tier" value="{{tier}}" min="{{tierMin}}" max="{{tierMax}}"/>
	</div>
	<div class="form-group">
		<label>Description</label>
		<textarea name="description">{{description}}</textarea>
	</div>
	<div class="form-group equipment-editor-tags">
		<label>Tags</label>
		<div class="equipment-editor-tag-list">
			{{#each tags}}
			<label class="equipment-editor-tag">
				<input type="checkbox" name="tag" value="{{key}}" {{#if checked}}checked{{/if}}/>
				<span class="equipment-editor-tag-label">{{label}} ({{value}})</span>
				{{#if description}}<span class="equipment-editor-tag-description">{{description}}</span>{{/if}}
			</label>
			{{/each}}
		</div>
		<p class="equipment-editor-tag-total">Total: <span class="equipment-editor-tag-total-value">{{tagTotal}}</span></p>
	</div>
</form>
