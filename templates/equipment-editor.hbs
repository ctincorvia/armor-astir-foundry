<form class="armor-astir-equipment-editor">
	{{#if note}}
	<p class="equipment-editor-note">{{note}}</p>
	{{/if}}
	<div class="equipment-editor-columns">
		<div class="equipment-editor-cell-identity">
			<div class="form-group">
				<label>Name</label>
				<input type="text" name="name" value="{{name}}"/>
			</div>
			{{#unless hideKind}}
			<div class="form-group">
				<label>Kind</label>
				<select name="kind" {{#if lockTags}}disabled{{/if}}>
					<option value="weapon" {{#if isWeapon}}selected{{/if}}>Weapon</option>
					<option value="gear" {{#unless isWeapon}}selected{{/unless}}>Gear</option>
				</select>
			</div>
			{{/unless}}
			{{#unless hideTier}}
			<div class="form-group equipment-editor-weapon-fields">
				<label>Tier</label>
				<input type="number" name="tier" value="{{tier}}" min="{{tierMin}}" max="{{tierMax}}" {{#if carrierWeapon}}disabled{{/if}} {{#if lockTags}}disabled{{/if}}/>
			</div>
			{{/unless}}
		</div>
		<div class="equipment-editor-cell-description">
			<div class="form-group">
				<label>Description</label>
				<textarea name="description">{{description}}</textarea>
			</div>
			<div class="equipment-editor-tag-chips">
				{{#each tagChips}}
				<span class="equipment-editor-tag-chip" data-tag-key="{{key}}" {{#unless checked}}style="display: none;"{{/unless}}>{{label}}</span>
				{{/each}}
			</div>
		</div>
		{{#if weaponRangeOptions.length}}
		<div class="equipment-editor-cell-range">
			<div class="form-group equipment-editor-weapon-range-field">
				<label>Range</label>
				<div class="equipment-editor-weapon-range-list">
					{{#each weaponRangeOptions}}
					<div class="equipment-editor-weapon-range-item">
						<label class="equipment-editor-weapon-range-option">
							<input type="radio" name="weapon-range" value="{{key}}" {{#if checked}}checked{{/if}} {{#if ../lockTags}}disabled{{/if}}/>
							<span class="equipment-editor-weapon-range-label">{{label}}</span>
						</label>
						{{#if description}}<div class="equipment-editor-weapon-range-description">{{description}}</div>{{/if}}
					</div>
					{{/each}}
				</div>
			</div>
		</div>
		{{/if}}
		<div class="equipment-editor-cell-tags">
			<div class="form-group equipment-editor-tags">
				<label>Tags</label>
				{{#each tagGroups}}
				<details class="equipment-editor-tag-group" {{#if open}}open{{/if}}>
					<summary class="equipment-editor-tag-group-label">{{label}}</summary>
					<div class="equipment-editor-tag-list">
						{{#each tags}}
						<div class="equipment-editor-tag" {{#if gearOnly}}data-gear-only="true"{{/if}}>
							<label class="equipment-editor-tag-option">
								<input type="checkbox" name="tag" value="{{key}}" {{#if checked}}checked{{/if}} {{#if ../../lockTags}}disabled{{/if}}/>
								<span class="equipment-editor-tag-label">{{label}} ({{value}})</span>
							</label>
							{{#if description}}<div class="equipment-editor-tag-description">{{description}}</div>{{/if}}
						</div>
						{{/each}}
					</div>
				</details>
				{{/each}}
				<div class="equipment-editor-tag-total-row">
					<p class="equipment-editor-tag-total">Total: <span class="equipment-editor-tag-total-value">{{tagTotal}}</span>{{#if hasTagValueCap}} (max <span class="equipment-editor-tag-max-value">{{maxTagValue}}</span>){{/if}}</p>
					{{#if showOverride}}
					<button type="button" class="equipment-editor-max-override-button" data-mode="override">Override Max</button>
					{{/if}}
				</div>
				{{#if showOverride}}
				<p class="equipment-editor-max-override-reminder" style="display: none;">Max value has been increased. Don't do this unless your director says you should.</p>
				{{/if}}
			</div>
		</div>
	</div>
</form>
