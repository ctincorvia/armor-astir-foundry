<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="flex3">
			<div class="form-group">
				<label>Name</label>
				<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
			</div>
			<div class="form-group">
				<label>Callsign</label>
				<input type="text" name="system.details.callsign.value" value="{{data.system.details.callsign.value}}" placeholder="Callsign"/>
			</div>
		</div>
		<div class="playbook-swap">
			<label>Playbook</label>
			<select class="playbook-select" name="playbook">
				{{selectOptions playbooks selected=currentPlaybookId valueAttr="packId" labelAttr="name"}}
			</select>
		</div>
		<div class="approach-swap">
			<label>Approach</label>
			<select name="system.attributes.approach">
				{{selectOptions approachOptions selected=data.system.attributes.approach valueAttr="key" labelAttr="label" blank="— Choose —"}}
			</select>
		</div>
	</header>
	<div class="status-row">
		<section class="traits">
			<h3>Traits</h3>
			<ol class="traits-list">
				{{#each traits}}
				<li class="trait {{#if disabled}}disabled{{/if}}" data-trait="{{key}}">
					<label class="trait-label">{{label}}</label>
					<div class="trait-control">
						<button type="button" class="trait-step trait-decrement" data-trait="{{key}}" data-delta="-1" {{#if disabled}}disabled{{/if}}>-</button>
						<span class="trait-value">{{value}}</span>
						<button type="button" class="trait-step trait-increment" data-trait="{{key}}" data-delta="1" {{#if disabled}}disabled{{/if}}>+</button>
					</div>
				</li>
				{{/each}}
			</ol>
			<div class="trait-meters">
				{{#if overheating.visible}}
				<label class="overheating-label">
					<input type="checkbox" class="overheating-checkbox" {{#if overheating.value}}checked{{/if}}/>
					Overheating
				</label>
				{{/if}}
				{{#if power.visible}}
				<div class="power-control">
					<label class="power-label">Power</label>
					<button type="button" class="power-step power-decrement" data-delta="-1">-</button>
					<span class="power-value">{{power.value}}</span>
					<button type="button" class="power-step power-increment" data-delta="1">+</button>
				</div>
				{{/if}}
			</div>
		</section>
		<section class="spotlight">
			<h3>Spotlight</h3>
			<ol class="spotlight-track">
				{{#each spotlight.steps}}
				<li class="spotlight-step-item">
					<button type="button" class="spotlight-step{{#if filled}} filled{{/if}}" data-step="{{step}}" aria-label="Spotlight step {{step}}"></button>
				</li>
				{{/each}}
			</ol>
		</section>
	</div>
	<section class="sheet-main">
		<aside class="dangers-column">
			<div class="section-header">
				<h3>Dangers ({{dangers.list.length}}/{{dangers.max}})</h3>
				{{#if dangers.canAdd}}
				<div class="section-header-actions">
					<button type="button" class="danger-add-toggle icon-add-button" title="Add a Danger" aria-label="Add a Danger" aria-expanded="{{dangers.addOpen}}">+</button>
				</div>
				{{/if}}
			</div>
			{{#if dangers.atMax}}
			<p class="defenseless-label">DEFENSELESS</p>
			{{/if}}
			<ol class="danger-list">
				{{#each dangers.list}}
				<li class="danger-item {{#if isPeril}}danger-peril{{else}}danger-risk{{/if}}">
					<span class="danger-label">{{label}}</span>
					<button type="button" class="danger-remove" data-danger-id="{{id}}" aria-label="Remove danger">✕</button>
				</li>
				{{/each}}
			</ol>
			{{#if dangers.addOpen}}
			<div class="danger-add-controls">
				<input type="text" class="danger-label-input" placeholder="Describe the danger…"/>
				<select class="danger-type-select">
					<option value="risk">Risk</option>
					<option value="peril">Peril</option>
				</select>
				<button type="button" class="danger-add">Add</button>
			</div>
			{{/if}}
		</aside>
		<div class="sheet-tabs-column">
			<nav class="sheet-tabs tabs" data-group="primary">
				<a class="item" data-tab="moves">Moves</a>
				<a class="item" data-tab="equipment">Equipment</a>
				<a class="item" data-tab="social">Social</a>
				<a class="item" data-tab="advancement">Advancement</a>
				<a class="item" data-tab="cosmetic">Cosmetic</a>
			</nav>
			<section class="sheet-body">
				<div class="tab" data-group="primary" data-tab="moves">
					<section class="moves">
						{{#each moveGroups}}
						<div class="section-header">
							<h3>{{label}}</h3>
							{{#if addable}}
							<div class="section-header-actions">
								<button type="button" class="playbook-move-add icon-add-button" title="Add a Playbook Move" aria-label="Add a Playbook Move">+</button>
							</div>
							{{/if}}
						</div>
						<ol class="move-list">
							{{#each moves}}
							<li class="move" data-move="{{key}}">
								<span class="move-name">{{name}}</span>
								<div class="move-row-controls">
									{{#if trackHold}}
									<div class="hold-control">
										<button type="button" class="{{#if separateHoldPool}}flat-hold-step{{else}}hold-step{{/if}} hold-decrement{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-delta="-1" {{#if gated}}disabled{{/if}}>-</button>
										<span class="hold-value">{{hold}}</span>
										<button type="button" class="{{#if separateHoldPool}}flat-hold-step{{else}}hold-step{{/if}} hold-increment{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-delta="1" {{#if gated}}disabled{{/if}}>+</button>
									</div>
									{{/if}}
									{{#if uses.length}}
									<div class="move-uses-control">
										{{#each uses}}
										<label class="move-use">
											<input type="checkbox" class="move-use-checkbox" data-move="{{../key}}" data-use="{{key}}" {{#if checked}}checked{{/if}}/>
											{{label}}
										</label>
										{{/each}}
									</div>
									{{/if}}
									<div class="move-controls">
										{{#if rollable}}
										<button type="button" class="move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" {{#if gated}}disabled{{/if}}>Roll</button>
										{{else if activatable}}
										<button type="button" class="move-activate{{#if gated}} disabled{{/if}}" data-move="{{key}}" {{#if gated}}disabled{{/if}}>Activate</button>
										{{/if}}
										<button type="button" class="move-description{{#if descriptionGated}} disabled{{/if}}" data-move="{{key}}" {{#if descriptionGated}}disabled{{/if}}>Description</button>
										{{#if ../removable}}
										<button type="button" class="playbook-move-remove" data-move="{{key}}" aria-label="Remove playbook move">✕</button>
										{{/if}}
									</div>
								</div>
							</li>
							{{/each}}
						</ol>
						{{/each}}
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="equipment">
					<section class="equipment">
						<div class="section-header">
							<h3>Weapons</h3>
							<div class="section-header-actions">
								{{#if equipment.startingGear.available}}
								<button type="button" class="starting-gear-add icon-add-button" title="Choose Starting Gear" aria-label="Choose Starting Gear">+</button>
								{{/if}}
								<button type="button" class="equipment-add icon-add-button" data-kind="weapon" title="Add Weapon" aria-label="Add Weapon">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="weapon" title="Pick Weapon from Catalog" aria-label="Pick Weapon from Catalog">O</button>
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.weapons}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<div class="equipment-tier-control">
										<button type="button" class="equipment-tier-step equipment-tier-decrement" data-equipment-id="{{id}}" data-delta="-1">-</button>
										<span class="equipment-tier-value">Tier {{tier}}</span>
										<button type="button" class="equipment-tier-step equipment-tier-increment" data-equipment-id="{{id}}" data-delta="1">+</button>
									</div>
									<span class="equipment-scale">{{scaleLabel}}</span>
									<div class="equipment-item-controls">
										<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
										<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
									</div>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
								{{#if weaponMoves.length}}
								<div class="weapon-move-controls">
									{{#each weaponMoves}}
									<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled{{/if}}>{{name}}</button>
									{{/each}}
								</div>
								{{/if}}
							</li>
							{{/each}}
						</ol>
						<div class="section-header">
							<h3>Gear</h3>
							<div class="section-header-actions">
								<button type="button" class="equipment-add icon-add-button" data-kind="gear" title="Add Gear" aria-label="Add Gear">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="gear" title="Pick Gear from Catalog" aria-label="Pick Gear from Catalog">O</button>
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.gear}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<div class="equipment-item-controls">
										<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
										<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
									</div>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
							</li>
							{{/each}}
						</ol>
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="social">
					{{#if gravityTrigger}}
					<section class="gravity-trigger">
						<h3>Gravity Trigger</h3>
						<p class="gravity-trigger-text">{{gravityTrigger}}</p>
					</section>
					{{/if}}
					<section class="gravity-clocks">
						<div class="section-header">
							<h3>Gravity Clocks ({{gravityClocks.list.length}}/{{gravityClocks.max}})</h3>
							{{#if gravityClocks.canAdd}}
							<div class="section-header-actions">
								<button type="button" class="gravity-clock-add icon-add-button" title="Add Gravity Clock" aria-label="Add Gravity Clock">+</button>
							</div>
							{{/if}}
						</div>
						<ol class="gravity-clock-list">
							{{#each gravityClocks.list}}
							<li class="gravity-clock-item" data-clock-id="{{id}}">
								<div class="gravity-clock-header">
									<input type="text" class="gravity-clock-label-input" data-clock-id="{{id}}" value="{{label}}" placeholder="Clock label…"/>
									<button type="button" class="gravity-clock-remove" data-clock-id="{{id}}" aria-label="Remove gravity clock">✕</button>
								</div>
								<div class="gravity-clock-body">
									<ol class="gravity-clock-track">
										{{#each progressSteps}}
										<li class="gravity-clock-step-item">
											<button type="button" class="gravity-clock-step{{#if filled}} filled{{/if}}" data-clock-id="{{../id}}" data-step="{{step}}" aria-label="Gravity clock step {{step}}"></button>
										</li>
										{{/each}}
									</ol>
									<div class="gravity-clock-value-control">
										<button type="button" class="gravity-clock-value-step gravity-clock-value-decrement" data-clock-id="{{id}}" data-delta="-1">-</button>
										<span class="gravity-clock-value">{{value}}</span>
										<button type="button" class="gravity-clock-value-step gravity-clock-value-increment" data-clock-id="{{id}}" data-delta="1">+</button>
									</div>
								</div>
							</li>
							{{/each}}
						</ol>
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="advancement">
					<section class="advancement">
						<h3>Advancement</h3>
						<ol class="advancement-list advancement-list-top">
							{{#each advancements.top}}
							<li class="advancement-item">
								<label class="advancement-label">
									<input type="checkbox" class="advancement-checkbox" data-advancement-key="{{key}}" {{#if checked}}checked{{/if}}/>
									<span class="advancement-text">{{label}}</span>
								</label>
							</li>
							{{/each}}
						</ol>
						<p class="advancement-unlock-hint">
							Check any {{advancements.unlockThreshold}} of the above to unlock the options below ({{advancements.topCount}}/{{advancements.unlockThreshold}}).
						</p>
						<ol class="advancement-list advancement-list-bottom">
							{{#each advancements.bottom}}
							<li class="advancement-item{{#if locked}} disabled{{/if}}">
								<label class="advancement-label">
									<input type="checkbox" class="advancement-checkbox" data-advancement-key="{{key}}" {{#if checked}}checked{{/if}} {{#if locked}}disabled{{/if}}/>
									<span class="advancement-text">{{label}}</span>
								</label>
							</li>
							{{/each}}
						</ol>
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="cosmetic">
					<section class="cosmetic">
						<div class="cosmetic-field">
							<h3>Appearance</h3>
							{{editor data.system.details.appearance.value target="system.details.appearance.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
						<div class="cosmetic-field">
							<h3>Backstory</h3>
							{{editor data.system.details.biography.value target="system.details.biography.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
						<div class="cosmetic-field">
							<h3>Notes</h3>
							{{editor data.system.details.notes.value target="system.details.notes.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
					</section>
				</div>
			</section>
		</div>
	</section>
</form>
