						<li class="entry-list-item{{#if summoned}} summoned{{/if}}" data-entry-id="{{id}}">
							<div class="entry-list-row">
								<input type="text" class="entry-list-field bound-ally-field bound-ally-name" data-entry-id="{{id}}" data-field="name" value="{{name}}" placeholder="Ally name"/>
								<select class="entry-list-field bound-ally-field bound-ally-approach" data-entry-id="{{id}}" data-field="approach">
									{{selectOptions ../boundAllies.approaches selected=approach valueAttr="key" labelAttr="label" blank="— Approach —"}}
								</select>
								<select class="entry-list-field bound-ally-field bound-ally-trait" data-entry-id="{{id}}" data-field="trait">
									{{selectOptions ../boundAllies.traits selected=trait valueAttr="key" labelAttr="label" blank="— Trait —"}}
								</select>
								<span class="bound-ally-power">Power Invested: {{powerInvested}}</span>
								<button type="button" class="bound-ally-invest icon-add-button labeled-add-button{{#unless ../boundAllies.canInvest}} disabled{{/unless}}" data-entry-id="{{id}}" {{#unless ../boundAllies.canInvest}}disabled{{/unless}} title="Invest 1 Power" aria-label="Invest 1 Power">+1 Power</button>
								<button type="button" class="bound-ally-release icon-add-button labeled-add-button" data-entry-id="{{id}}" aria-label="Release ally">Release</button>
							</div>
						</li>
						{{/each}}
					</ol>
				</section>
				{{/if}}
				</div>
				<div class="tab" data-group="primary" data-tab="advancement">
					<section class="advancement">
						<h3>Advancement</h3>
						<ol class="advancement-list advancement-list-top">
							{{#each advancements.top}}
							<li class="advancement-item">
								<label class="advancement-label">
									<input type="checkbox" class="advancement-checkbox" data-advancement-key="{{key}}" {{#if checked}}checked{{/if}}/>
									<span class="advancement-text">{{label}}</span>
								</label>
							</li>
							{{/each}}
						</ol>
						<p class="advancement-unlock-hint">
							Check any {{advancements.unlockThreshold}} of the above to unlock the options below ({{advancements.topCount}}/{{advancements.unlockThreshold}}).
						</p>
						<ol class="advancement-list advancement-list-bottom">
							{{#each advancements.bottom}}
							<li class="advancement-item{{#if locked}} disabled{{/if}}">
								<label class="advancement-label">
									<input type="checkbox" class="advancement-checkbox" data-advancement-key="{{key}}" {{#if checked}}checked{{/if}} {{#if locked}}disabled{{/if}}/>
									<span class="advancement-text">{{label}}</span>
								</label>
							</li>
							{{/each}}
						</ol>
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="downtime">
					<section class="downtime">
						<div class="power-control downtime-tokens-control">
							<label class="power-label">Downtime Tokens</label>
							<button type="button" class="power-step downtime-tokens-step downtime-tokens-decrement" data-delta="-1">-</button>
							<span class="power-value">{{downtimeTokens.value}} / {{downtimeTokens.max}}</span>
							<button type="button" class="power-step downtime-tokens-step downtime-tokens-increment" data-delta="1">+</button>
						</div>
						{{#if downtimeAlly}}
						<div class="power-control downtime-ally-control">
							<label class="power-label">Downtime Ally</label>
							{{#if downtimeAlly.exists}}
							<input type="text" class="downtime-ally-name-input" value="{{downtimeAlly.name}}" placeholder="Ally name"/>
							<button type="button" class="downtime-ally-invest icon-add-button labeled-add-button{{#unless downtimeAlly.canInvest}} disabled{{/unless}}" {{#unless downtimeAlly.canInvest}}disabled{{/unless}} title="Invest 1 Power" aria-label="Invest 1 Power">+1 Power</button>
							<span class="power-value">Power Invested: {{downtimeAlly.powerInvested}}</span>
							<button type="button" class="downtime-ally-release icon-add-button labeled-add-button" aria-label="Release Downtime Ally">Release</button>
							{{else}}
							<button type="button" class="downtime-ally-add icon-add-button labeled-add-button" title="Bind a Downtime Ally" aria-label="Bind a Downtime Ally">+ Bind Downtime Ally</button>
							{{/if}}
						</div>
						{{/if}}
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="cosmetic">
					<section class="cosmetic">
						<div class="cosmetic-field">
							<h3>Look</h3>
							{{editor lookText target="system.details.look.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
						<div class="cosmetic-field">
							<h3>Consider</h3>
							{{editor considerText target="system.details.consider.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
						<div class="cosmetic-field">
							<h3>Backstory</h3>
							{{editor data.system.details.biography.value target="system.details.biography.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
						<div class="cosmetic-field">
							<h3>Notes</h3>
							{{editor data.system.details.notes.value target="system.details.notes.value" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
						</div>
					</section>
				</div>
			</section>
		</div>
	</section>
</form>
