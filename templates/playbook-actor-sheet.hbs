<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="flex3">
			<div class="form-group">
				<label>Name</label>
				<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
			</div>
			<div class="form-group">
				<label>Callsign</label>
				<input type="text" name="system.details.callsign.value" value="{{data.system.details.callsign.value}}" placeholder="Callsign"/>
			</div>
		</div>
		<div class="playbook-swap">
			<label>Playbook</label>
			<select class="playbook-select" name="playbook">
				{{selectOptions playbooks selected=currentPlaybookId valueAttr="packId" labelAttr="name"}}
			</select>
		</div>
		<div class="approach-swap">
			<label>Approach</label>
			<select name="system.attributes.approach">
				{{selectOptions approachOptions selected=approach.base valueAttr="key" labelAttr="label" blank="— Choose —"}}
			</select>
			{{#if approach.effectiveLabel}}
			<span class="approach-effective-note">
				Current: {{approach.effectiveLabel}}{{#if approach.fromFrame}} (from {{approach.frameName}}){{/if}}{{#if approach.fromMove}} (from {{approach.moveName}}){{/if}}
			</span>
			{{/if}}
		</div>
		<div class="tier-readout">
			<label>Tier</label>
			<span class="tier-value">{{tier.effective}}{{#if tier.fromFrame}} ({{tier.frameName}}){{/if}}</span>
		</div>
	</header>
	<div class="status-row">
		<section class="traits">
			<h3>Traits</h3>
			<ol class="traits-list">
				{{#each traits}}
				<li class="trait {{#if disabled}}disabled{{/if}}" data-trait="{{key}}">
					<label class="trait-label">{{label}}</label>
					<div class="trait-control">
						<button type="button" class="trait-step trait-decrement" data-trait="{{key}}" data-delta="-1" {{#if disabled}}disabled{{/if}}>-</button>
						<span class="trait-value">{{value}}{{#if bonus}}<span class="trait-bonus">+{{bonus}}</span>{{/if}}{{#if allyBonus}}<span class="trait-ally-bonus"> ({{allyBonus}})</span>{{/if}}</span>
						<button type="button" class="trait-step trait-increment" data-trait="{{key}}" data-delta="1" {{#if disabled}}disabled{{/if}}>+</button>
					</div>
				</li>
				{{/each}}
			</ol>
		</section>
		<section class="spotlight">
			<h3>Spotlight</h3>
			<ol class="spotlight-track">
				{{#each spotlight.steps}}
				<li class="spotlight-step-item">
					<button type="button" class="spotlight-step{{#if filled}} filled{{/if}}" data-step="{{step}}" aria-label="Spotlight step {{step}}"></button>
				</li>
				{{/each}}
			</ol>
		</section>
	</div>
	<section class="sheet-main">
		<aside class="dangers-column">
			<div class="dangers-panel">
				<div class="section-header">
					<h3>Dangers ({{dangers.list.length}}/{{dangers.max}})</h3>
					{{#if dangers.canAdd}}
					<div class="section-header-actions">
						<button type="button" class="danger-add-toggle icon-add-button" title="Add a Danger" aria-label="Add a Danger" aria-expanded="{{dangers.addOpen}}">+</button>
					</div>
					{{/if}}
				</div>
				{{#if isCaptain}}
				<label class="at-helm-label">
					<input type="checkbox" class="at-helm-checkbox" {{#if atHelm}}checked{{/if}}/>
					At the Helm
				</label>
				{{/if}}
				{{#if dangers.atMax}}
				<p class="defenseless-label">DEFENSELESS</p>
				{{/if}}
				<ol class="danger-list">
					{{#each dangers.list}}
					<li class="danger-item {{#if isPeril}}danger-peril{{else}}danger-risk{{/if}}">
						<span class="danger-label">{{label}}</span>
						<button type="button" class="danger-remove" data-danger-id="{{id}}" aria-label="Remove danger">✕</button>
					</li>
					{{/each}}
				</ol>
				{{#if dangers.addOpen}}
				<div class="danger-add-controls">
					<input type="text" class="danger-label-input" placeholder="Describe the danger…"/>
					<select class="danger-type-select">
						<option value="risk">Risk</option>
						<option value="peril">Peril</option>
					</select>
					<button type="button" class="danger-add">Add</button>
				</div>
				{{/if}}
			</div>
			<div class="controls-panel">
				<div class="section-header">
					<h3>Controls</h3>
				</div>
				<div class="controls-actions">
					<button type="button" class="controls-mount-up{{#if controls.mountUpDisabled}} disabled{{/if}}" {{#if controls.mountUpDisabled}}disabled{{/if}}>Mount Up</button>
					<button type="button" class="controls-dismount{{#if controls.dismountDisabled}} disabled{{/if}}" {{#if controls.dismountDisabled}}disabled{{/if}}>Dismount</button>
					<button type="button" class="controls-refresh-scene">Refresh Scene</button>
					<button type="button" class="controls-refresh-sortie">Refresh Sortie</button>
				</div>
			</div>
		</aside>
		<div class="sheet-tabs-column">
			<nav class="sheet-tabs tabs" data-group="primary">
				<a class="item" data-tab="moves">Moves</a>
				<a class="item" data-tab="equipment">Equipment</a>
				<a class="item" data-tab="astir">Astir &amp; Ardents</a>
				<a class="item" data-tab="social">Social</a>
				<a class="item" data-tab="advancement">Advancement</a>
				<a class="item" data-tab="downtime">Downtime</a>
				<a class="item" data-tab="cosmetic">Cosmetic</a>
			</nav>
			<section class="sheet-body">
				<div class="tab" data-group="primary" data-tab="moves">
					<section class="moves">
						{{#each moveGroups}}
						<div class="section-header">
							<h3>{{label}}</h3>
							{{#if addable}}
							<div class="section-header-actions">
								{{#if startingMovesAvailable}}
								<button type="button" class="starting-moves-add icon-add-button labeled-add-button" title="Choose Starting Moves" aria-label="Choose Starting Moves">+ Starting Moves</button>
								{{else}}
								<button type="button" class="playbook-move-add icon-add-button" title="Add a Playbook Move" aria-label="Add a Playbook Move">+</button>
								{{/if}}
							</div>
							{{/if}}
						</div>
						<ol class="move-list">
							{{#each moves}}
							<li class="move" data-move="{{key}}">
								<div class="move-name-column">
									<span class="move-name">{{name}}</span>
									{{#if summonedAllyInfo}}
									<p class="move-summon-info">Summoned: {{summonedAllyInfo.name}} ({{summonedAllyInfo.traitLabel}}) — currently +{{summonedAllyInfo.value}}</p>
									{{/if}}
								</div>
								<div class="move-row-controls">
									{{#if trackHold}}
									<div class="hold-control">
										<button type="button" class="{{#if separateHoldPool}}flat-hold-step{{else}}hold-step{{/if}} hold-decrement{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-delta="-1" {{#if gated}}disabled{{/if}}>-</button>
										<span class="hold-value">{{hold}}</span>
										<button type="button" class="{{#if separateHoldPool}}flat-hold-step{{else}}hold-step{{/if}} hold-increment{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-delta="1" {{#if gated}}disabled{{/if}}>+</button>
									</div>
									{{/if}}
									{{#if uses.length}}
									<div class="move-uses-control">
										{{#each uses}}
										<label class="move-use">
											<input type="checkbox" class="move-use-checkbox" data-move="{{../key}}" data-use="{{key}}" {{#if checked}}checked{{/if}}/>
											{{label}}
										</label>
										{{/each}}
									</div>
									{{/if}}
									{{#if trackers.length}}
									<div class="move-trackers-control">
										{{#each trackers}}
										<div class="move-tracker">
											<span class="move-tracker-label">{{label}}</span>
											<button type="button" class="move-tracker-step move-tracker-decrement" data-move="{{../key}}" data-tracker="{{key}}" data-delta="-1" data-min="{{min}}" data-max="{{max}}" aria-label="Decrease {{label}}">-</button>
											<span class="move-tracker-value">{{value}}</span>
											<button type="button" class="move-tracker-step move-tracker-increment" data-move="{{../key}}" data-tracker="{{key}}" data-delta="1" data-min="{{min}}" data-max="{{max}}" aria-label="Increase {{label}}">+</button>
										</div>
										{{/each}}
									</div>
									{{/if}}
									{{#if traitBonusChoosable}}
									<div class="move-trait-bonus-control">
										<select class="trait-bonus-select" data-move="{{key}}">
											{{selectOptions @root.traits selected=traitBonusChoice valueAttr="key" labelAttr="label" blank="—"}}
										</select>
									</div>
									{{/if}}
									<div class="move-controls">
										{{#if rollable}}
										<button type="button" class="move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" {{#if gated}}disabled{{#if gatedTooltip}} data-gate-tooltip="{{gatedTooltip}}"{{/if}}{{/if}}>Roll</button>
										{{else if activatable}}
										<button type="button" class="move-activate{{#if gated}} disabled{{/if}}" data-move="{{key}}" {{#if gated}}disabled{{/if}}>Activate</button>
										{{else if summonable}}
										<button type="button" class="move-summon{{#if gated}} disabled{{/if}}" data-move="{{key}}" {{#if gated}}disabled{{/if}}>Summon</button>
										{{/if}}
										<button type="button" class="move-description{{#if descriptionGated}} disabled{{/if}}" data-move="{{key}}" {{#if descriptionGated}}disabled{{/if}}>Chat</button>
										<button type="button" class="move-info{{#if descriptionGated}} disabled{{/if}}" data-move="{{key}}" {{#if descriptionGated}}disabled{{/if}} aria-label="{{name}} rules text">?</button>
										{{#if ../removable}}
										<button type="button" class="playbook-move-remove" data-move="{{key}}" aria-label="Remove playbook move">✕</button>
										{{/if}}
									</div>
								</div>
							</li>
							{{/each}}
						</ol>
						{{/each}}
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="equipment">
					<section class="equipment">
						<div class="section-header">
							<h3>Weapons</h3>
							<div class="section-header-actions">
								{{#if equipment.startingGear.available}}
								<button type="button" class="starting-gear-add icon-add-button labeled-add-button" title="Choose Starting Gear" aria-label="Choose Starting Gear">+ Starting Equipment</button>
								{{else}}
								<button type="button" class="equipment-add icon-add-button" data-kind="weapon" title="Add Weapon" aria-label="Add Weapon">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="weapon" title="Pick Weapon from Catalog" aria-label="Pick Weapon from Catalog">O</button>
								{{/if}}
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.weapons}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<span class="equipment-tier-value">Tier {{tier}}</span>
									<span class="equipment-scale">{{scaleLabel}}</span>
									<div class="equipment-item-controls">
										<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
										<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
									</div>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
								{{#if weaponMoves.length}}
								<div class="weapon-move-controls">
									{{#each weaponMoves}}
									<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled data-gate-tooltip="{{tooltip}}"{{/if}}>{{name}}</button>
									{{/each}}
								</div>
								{{/if}}
							</li>
							{{/each}}
						</ol>
						{{#if equipment.astirWeapons.length}}
						<div class="section-header">
							<h3>Astir Weapons</h3>
						</div>
						<ol class="equipment-list">
							{{#each equipment.astirWeapons}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<span class="equipment-tier-value">Tier {{tier}}</span>
									<span class="equipment-scale">{{scaleLabel}}</span>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
								{{#if weaponMoves.length}}
								<div class="weapon-move-controls">
									{{#each weaponMoves}}
									<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled data-gate-tooltip="{{tooltip}}"{{/if}}>{{name}}</button>
									{{/each}}
								</div>
								{{/if}}
							</li>
							{{/each}}
						</ol>
						{{/if}}
						{{#if equipment.ardentWeapons.length}}
						<div class="section-header">
							<h3>Ardent Weapons</h3>
						</div>
						<ol class="equipment-list">
							{{#each equipment.ardentWeapons}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<span class="equipment-tier-value">Tier {{tier}}</span>
									<span class="equipment-scale">{{scaleLabel}}</span>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
								{{#if weaponMoves.length}}
								<div class="weapon-move-controls">
									{{#each weaponMoves}}
									<button type="button" class="weapon-move-roll{{#if gated}} disabled{{/if}}" data-move="{{key}}" data-equipment-id="{{../id}}" {{#if gated}}disabled data-gate-tooltip="{{tooltip}}"{{/if}}>{{name}}</button>
									{{/each}}
								</div>
								{{/if}}
							</li>
							{{/each}}
						</ol>
						{{/if}}
						<div class="section-header">
							<h3>Gear</h3>
							<div class="section-header-actions">
								{{#unless equipment.startingGear.available}}
								<button type="button" class="equipment-add icon-add-button" data-kind="gear" title="Add Gear" aria-label="Add Gear">+</button>
								<button type="button" class="equipment-catalog-add icon-add-button" data-kind="gear" title="Pick Gear from Catalog" aria-label="Pick Gear from Catalog">O</button>
								{{/unless}}
							</div>
						</div>
						<ol class="equipment-list">
							{{#each equipment.gear}}
							<li class="equipment-item" data-equipment-id="{{id}}">
								<div class="equipment-header">
									<span class="equipment-name">{{name}}</span>
									<span class="equipment-value">Value {{value}}</span>
									<div class="equipment-item-controls">
										<button type="button" class="equipment-edit" data-equipment-id="{{id}}">Edit</button>
										<button type="button" class="equipment-remove" data-equipment-id="{{id}}" aria-label="Remove equipment">✕</button>
									</div>
								</div>
								{{#if description}}
								<div class="equipment-description">{{description}}</div>
								{{/if}}
								{{#if tags.length}}
								<ul class="equipment-tag-list">
									{{#each tags}}
									<li class="equipment-tag">
										<span class="equipment-tag-label">{{label}} ({{value}})</span>
										{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
										{{#if spendable}}
										<label class="equipment-tag-spent">
											<input type="checkbox" class="equipment-tag-spent-checkbox" data-equipment-id="{{../id}}" data-tag="{{key}}" {{#if spent}}checked{{/if}}/>
											Spent
										</label>
										{{/if}}
									</li>
									{{/each}}
								</ul>
								{{/if}}
							</li>
							{{/each}}
						</ol>
					</section>
				</div>
				<div class="tab" data-group="primary" data-tab="astir">
					{{#if astir.available}}
					{{#if astir.exists}}
					<section class="astir">
						<div class="section-header">
							<img class="astir-portrait" src="{{astir.img}}" data-edit="system.attributes.astir.img" alt="{{astir.name}}"/>
							<h3>{{astir.name}}</h3>
							<div class="section-header-actions">
								<button type="button" class="astir-delete icon-add-button" title="Delete Astir" aria-label="Delete Astir">✕</button>
							</div>
						</div>
						<div class="astir-identity-fields">
							<div class="form-group">
								<label>Core</label>
								<select class="astir-core-select">
									{{selectOptions astir.cores selected=astir.core valueAttr="key" labelAttr="label" blank="— Choose —"}}
								</select>
							</div>
							<div class="form-group">
								<label>Approach</label>
								<select class="astir-approach-select">
									{{selectOptions astir.approachOptions selected=astir.approach valueAttr="key" labelAttr="label" blank="— Choose —"}}
								</select>
							</div>
							<div class="equipment-tier-control">
								<button type="button" class="equipment-tier-step astir-tier-step astir-tier-decrement" data-delta="-1">-</button>
								<span class="equipment-tier-value">Tier {{astir.tier}}</span>
								<button type="button" class="equipment-tier-step astir-tier-step astir-tier-increment" data-delta="1">+</button>
							</div>
						</div>
						<div class="trait-meters">
							<label class="overheating-label">
								<input type="checkbox" class="astir-overheating-checkbox" {{#if astir.overheating}}checked{{/if}}/>
								Overheating
							</label>
							<label class="piloted-label">
								<input type="checkbox" class="astir-piloted-checkbox" {{#if astir.piloted}}checked{{/if}}/>
								Piloted
							</label>
							{{#if astir.power.negative}}
							<p class="astir-power-negative-note">Power is negative — this Astir cannot be piloted until the loadout changes.</p>
							{{/if}}
							<div class="power-control">
								<label class="power-label">Power</label>
								<button type="button" class="power-step astir-power-step astir-power-decrement" data-delta="-1">-</button>
								<span class="power-value{{#if astir.power.negative}} power-value-negative{{/if}}">{{astir.power.value}} / {{astir.power.max}}</span>
								<button type="button" class="power-step astir-power-step astir-power-increment" data-delta="1">+</button>
							</div>
							{{#if astir.weaponPower.max}}
							<div class="power-control">
								<label class="power-label">Weapon Power</label>
								<button type="button" class="power-step astir-weapon-power-step astir-weapon-power-decrement" data-delta="-1">-</button>
								<span class="power-value">{{astir.weaponPower.value}} / {{astir.weaponPower.max}}</span>
								<button type="button" class="power-step astir-weapon-power-step astir-weapon-power-increment" data-delta="1">+</button>
							</div>
							{{/if}}
							{{#if astir.repairTokens}}
							<div class="form-group repair-tokens-control">
								<label>Repair Tokens</label>
								<input type="number" min="0" name="system.attributes.astir.repairTokens" value="{{astir.repairTokens.value}}"/>
							</div>
							{{/if}}
						</div>
						{{#if astir.potions}}
						<div class="section-header">
							<h3>Potions</h3>
						</div>
						<ol class="potion-list">
							<li class="potion">
								<span class="potion-label">Red</span>
								<span class="potion-value">{{astir.potions.red}}</span>
								<button type="button" class="astir-potion-use" data-potion="red" {{#unless astir.potions.red}}disabled{{/unless}}>Use</button>
							</li>
							<li class="potion">
								<span class="potion-label">Blue</span>
								<span class="potion-value">{{astir.potions.blue}}</span>
								<button type="button" class="astir-potion-use" data-potion="blue" {{#unless astir.potions.blue}}disabled{{/unless}}>Use</button>
							</li>
							<li class="potion">
								<span class="potion-label">Yellow</span>
								<span class="potion-value">{{astir.potions.yellow}}</span>
