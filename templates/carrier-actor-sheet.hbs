<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="form-group">
			<label>Name</label>
			<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
		</div>
	</header>
	<section class="crew">
		<h3>Crew</h3>
		<div class="trait-control">
			<button type="button" class="crew-step crew-decrement" data-delta="-1">-</button>
			<span class="trait-value">{{crew}}</span>
			<button type="button" class="crew-step crew-increment" data-delta="1">+</button>
		</div>
	</section>
	<section class="description">
		<h3>Description</h3>
		<textarea name="system.details.description.value" placeholder="Describe the Carrier…">{{description}}</textarea>
	</section>
	<section class="weapons">
		<div class="section-header">
			<h3>Weapons</h3>
		</div>
		<ol class="entry-list weapon-list">
			{{#each weaponSlots}}
			<li class="entry-list-item" data-slot="{{key}}">
				<h4 class="weapon-slot-label">{{label}}</h4>
				{{#if entry}}
				<div class="equipment-header">
					<span class="equipment-name">{{entry.name}}</span>
					<span class="equipment-value">Value {{entry.value}}</span>
					<span class="equipment-value">Tier {{entry.tier}}</span>
					<span class="equipment-scale">{{entry.scaleLabel}}</span>
					<div class="equipment-item-controls">
						<button type="button" class="weapon-edit equipment-edit" data-slot="{{key}}">Edit</button>
						<button type="button" class="weapon-remove entry-list-remove" data-slot="{{key}}" aria-label="Remove weapon">✕</button>
					</div>
				</div>
				{{#if entry.description}}
				<div class="equipment-description">{{entry.description}}</div>
				{{/if}}
				{{#if entry.tags.length}}
				<ul class="equipment-tag-list">
					{{#each entry.tags}}
					<li class="equipment-tag">
						<span class="equipment-tag-label">{{label}} ({{value}})</span>
						{{#if description}}<span class="equipment-tag-description">{{description}}</span>{{/if}}
					</li>
					{{/each}}
				</ul>
				{{/if}}
				{{#if entry.moves.length}}
				<div class="weapon-move-controls">
					{{#each entry.moves}}
					<button type="button" class="weapon-move-roll" data-move="{{key}}" data-slot="{{../key}}">{{name}}</button>
					{{/each}}
				</div>
				{{/if}}
				{{else}}
				<div class="section-header-actions">
					<button type="button" class="weapon-add icon-add-button" data-slot="{{key}}" title="Add {{label}}" aria-label="Add {{label}}">+</button>
				</div>
				{{/if}}
			</li>
			{{/each}}
		</ol>
	</section>
	{{#if quarters.length}}
	<section class="quarters">
		<div class="section-header"><h3>Quarters</h3></div>
		<ol class="entry-list quarters-list">
			{{#each quarters}}
			<li class="entry-list-item">
				<h4>{{name}} <span class="quarters-owner">({{actorName}})</span></h4>
				{{#if description}}<p class="quarters-description">{{description}}</p>{{/if}}
				{{#if benefitLabels.length}}
				<ul class="quarters-benefit-list">
					{{#each benefitLabels}}<li>{{this}}</li>{{/each}}
				</ul>
				{{/if}}
			</li>
			{{/each}}
		</ol>
	</section>
	{{/if}}
	<section class="crew-members">
		<div class="section-header">
			<h3>Crew Members ({{crewMembers.length}})</h3>
			<div class="section-header-actions">
				<button type="button" class="entry-list-add icon-add-button" data-list="crewMembers" title="Add Crew Member" aria-label="Add Crew Member">+</button>
			</div>
		</div>
		<ol class="entry-list crew-member-list">
			{{#each crewMembers}}
			<li class="entry-list-item" data-entry-id="{{id}}">
				<div class="entry-list-row">
					<input type="text" class="entry-list-field crew-member-name" data-list="crewMembers" data-entry-id="{{id}}" data-field="name" value="{{name}}" placeholder="Name"/>
					<input type="text" class="entry-list-field crew-member-position" data-list="crewMembers" data-entry-id="{{id}}" data-field="position" value="{{position}}" placeholder="Position"/>
					<button type="button" class="entry-list-remove" data-list="crewMembers" data-entry-id="{{id}}" aria-label="Remove crew member">✕</button>
				</div>
				<textarea class="entry-list-field crew-member-description" data-list="crewMembers" data-entry-id="{{id}}" data-field="description" placeholder="Brief description…">{{description}}</textarea>
			</li>
			{{/each}}
		</ol>
	</section>
</form>
