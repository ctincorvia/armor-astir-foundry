<form class="armor-astir-move-roll-dialog">
{{#if weaponBundles}}
	<div class="move-roll-grid">
		<div class="move-roll-column-1">
			<h3 class="move-roll-column-header">Controls</h3>
			<div class="form-group move-roll-select-group{{#unless (gt weaponBundles.length 1)}} move-roll-select-group-hidden{{/unless}}">
				<label>Weapon</label>
				<select name="weapon-select">
					{{#each weaponBundles}}
					<option value="{{weaponKey}}" {{#if @first}}selected{{/if}}>{{weaponLabel}}</option>
					{{/each}}
				</select>
			</div>
			{{#each weaponBundles}}
			<div class="move-roll-weapon-panel{{#if @first}} active{{/if}}" data-weapon-panel="{{weaponKey}}">
				{{#if traits.length}}
				<div class="form-group move-roll-select-group" data-trait-group>
					<label>Trait</label>
					{{#if (gt traits.length 1)}}
					<select name="trait" {{#if ../lockedTrait}}disabled{{/if}}>
						{{selectOptions traitOptions selected=../lockedTrait.key valueAttr="key" labelAttr="label"}}
					</select>
					{{else}}
					{{#each traits}}
					<span class="move-roll-trait-label">{{label}} ({{value}})</span>
					<input type="hidden" name="trait" value="{{key}}"/>
					{{/each}}
					{{/if}}
				</div>
				{{/if}}
				{{#if ../lockedTrait}}
				<p class="move-roll-locked-note">Locked: {{../lockedTrait.label}}</p>
				{{/if}}
			</div>
			{{/each}}
			{{#if (and gravityClocks.length (not lockedTrait))}}
			<div class="form-group move-roll-select-group">
				<label>Gravity</label>
				<input type="checkbox" name="has-gravity"/>
			</div>
			<div class="form-group move-roll-select-group move-roll-select-group-hidden" data-gravity-target-group>
				<label>Gravity Target</label>
				<select name="gravity-target">
					{{#each gravityClocks}}
					<option value="{{id}}">{{target}} (+{{value}})</option>
					{{/each}}
				</select>
			</div>
			{{/if}}
			<div class="form-group move-roll-select-group">
				<label>Dice</label>
				{{> "modules/armor-astir/templates/shared/notched-slider.hbs" name="advantage" states=advantageStates selectedKey=advantageSelectedKey selectedLabel=advantageSelectedLabel}}
			</div>
			<div class="form-group move-roll-select-group">
				<label>Effect</label>
				{{> "modules/armor-astir/templates/shared/notched-slider.hbs" name="effect" states=effectStates selectedKey=effectSelectedKey selectedLabel=effectSelectedLabel}}
			</div>
		</div>
		<div class="move-roll-column-2">
			<h3 class="move-roll-column-header">Weapons, Riders, and Modifiers</h3>
			{{#each weaponBundles}}
			<div class="move-roll-weapon-panel{{#if @first}} active{{/if}}" data-weapon-panel="{{weaponKey}}">
				{{#if weaponCard}}
				{{#with weaponCard}}{{> "modules/armor-astir/templates/shared/equipment-card.hbs" class="move-roll-weapon-card" readOnly=true hideTags=true}}{{/with}}
				{{else}}
				<p class="move-roll-weapon-card-unarmed">Unarmed</p>
				{{/if}}
				{{#if narrativeTags.length}}
				<div class="form-group move-roll-equipment move-roll-list-section">
					<label>Tags</label>
					<div class="equipment-tags-block"><ul class="equipment-tag-list">
						{{#each narrativeTags}}
						<li class="equipment-tag"><span class="equipment-tag-label">{{#if (ne equipmentName ../weaponLabel)}}{{equipmentName}} — {{/if}}{{tagLabel}}{{#if showValue}} ({{value}}){{/if}}</span><span class="equipment-tag-description">{{description}}</span></li>
						{{/each}}
					</ul></div>
				</div>
				{{/if}}
				{{#if rerollTag}}
				<div class="form-group move-roll-equipment move-roll-list-section">
					<label>Reroll</label>
					<div class="equipment-tags-block"><ul class="equipment-tag-list">
						<li class="equipment-tag"><span class="equipment-tag-label">{{rerollTag.tagLabel}}</span><span class="equipment-tag-description">{{rerollTag.description}}</span></li>
					</ul></div>
				</div>
				{{/if}}
				{{#if equipmentSpends.length}}
				<div class="form-group move-roll-equipment move-roll-list-section">
					<label>Equipment</label>
					<div class="move-roll-equipment-list">
						{{#each equipmentSpends}}
						<div class="move-roll-equipment-spend{{#if disabled}} disabled{{/if}}">
							<label class="move-roll-equipment-spend-option">
								<input type="checkbox" name="equipment-tag" value="{{equipmentId}}::{{tagKey}}" {{#if disabled}}disabled{{/if}}/>
								<span class="move-roll-equipment-name">{{#if (ne equipmentName ../weaponLabel)}}{{equipmentName}} — {{/if}}{{tagLabel}}</span>
							</label>
							<div class="move-roll-equipment-description">{{description}}</div>
						</div>
						{{/each}}
					</div>
				</div>
				{{/if}}
				<div class="form-group move-roll-equipment move-roll-list-section">
					<label>Roll Modifiers</label>
					{{#if rollModifiers.length}}
					<div class="move-roll-equipment-list">
						{{#each rollModifiers}}
						<div class="move-roll-equipment-spend{{#if disabled}} disabled{{/if}}" data-roll-modifier-row="{{key}}">
							<label class="move-roll-equipment-spend-option">
								{{#unless reminderOnly}}
								<input type="checkbox" name="roll-modifier"
								       value="{{key}}" {{#if forced}}checked disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}/>
								{{/unless}}
								<span class="move-roll-equipment-name">{{label}}</span>
								{{#if forced}}<span class="move-roll-modifier-deferred-note">(automatic)</span>{{/if}}
							</label>
							<div class="move-roll-equipment-description">{{{description}}}</div>
							<div class="move-roll-modifier-reason" data-roll-modifier-reason>{{disabledReason}}</div>
						</div>
						{{/each}}
					</div>
					{{else}}
					<p class="move-roll-list-section-empty">There are no roll modifiers for this roll.</p>
					{{/if}}
				</div>
				{{#if lockedEffect}}
				<p class="move-roll-locked-note">Locked: {{lockedEffectLabel}}</p>
				{{/if}}
				{{#if guided}}
				<p class="move-roll-guided-note">{{guided}}: use the "Take 7-9" button below to skip rolling.</p>
				{{/if}}
			</div>
			{{/each}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Riders</label>
				{{#if riders.length}}
				<div class="move-roll-equipment-list">
					{{#each riders}}
					<div class="move-roll-equipment-spend">
						<span class="move-roll-equipment-name">{{label}}</span>
						<div class="move-roll-equipment-description">{{text}}</div>
					</div>
					{{/each}}
				</div>
				{{else}}
				<p class="move-roll-list-section-empty">There are no riders for this roll.</p>
				{{/if}}
			</div>
		</div>
	</div>
{{else}}
	<div class="move-roll-grid">
		<div class="move-roll-column-1">
			<h3 class="move-roll-column-header">Controls</h3>
			{{#if traits.length}}
			<div class="form-group move-roll-select-group" data-trait-group>
				<label>Trait</label>
				{{#if (gt traits.length 1)}}
				<select name="trait" {{#if lockedTrait}}disabled{{/if}}>
					{{selectOptions traitOptions selected=lockedTrait.key valueAttr="key" labelAttr="label"}}
				</select>
				{{else}}
				{{#each traits}}
				<span class="move-roll-trait-label">{{label}} ({{value}})</span>
				<input type="hidden" name="trait" value="{{key}}"/>
				{{/each}}
				{{/if}}
			</div>
			{{/if}}
			{{#if (and traits.length gravityClocks.length (not lockedTrait))}}
			<div class="form-group move-roll-select-group">
				<label>Gravity</label>
				<input type="checkbox" name="has-gravity"/>
			</div>
			<div class="form-group move-roll-select-group move-roll-select-group-hidden" data-gravity-target-group>
				<label>Gravity Target</label>
				<select name="gravity-target">
					{{#each gravityClocks}}
					<option value="{{id}}">{{target}} (+{{value}})</option>
					{{/each}}
				</select>
			</div>
			{{/if}}
			{{#if intents}}
			<div class="form-group move-roll-select-group">
				<label>Intent</label>
				<select name="intent">
					{{#each intents}}
					<option value="{{key}}">{{label}}</option>
					{{/each}}
				</select>
			</div>
			{{/if}}
			{{#if conditions}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Conditions</label>
				<div class="move-roll-conditions-list">
					{{#each conditions}}
					<label class="move-roll-condition">
						<input type="checkbox" name="condition" value="{{key}}"/> {{label}}
					</label>
					{{/each}}
				</div>
			</div>
			{{/if}}
			<div class="form-group move-roll-select-group">
				<label>Dice</label>
				{{> "modules/armor-astir/templates/shared/notched-slider.hbs" name="advantage" states=advantageStates selectedKey=advantageSelectedKey selectedLabel=advantageSelectedLabel}}
			</div>
			<div class="form-group move-roll-select-group">
				<label>Effect</label>
				{{> "modules/armor-astir/templates/shared/notched-slider.hbs" name="effect" states=effectStates selectedKey=effectSelectedKey selectedLabel=effectSelectedLabel}}
			</div>
			{{#if lockedTrait}}
			<p class="move-roll-locked-note">Locked: {{lockedTrait.label}}</p>
			{{/if}}
			{{#if lockedEffect}}
			<p class="move-roll-locked-note">Locked: {{lockedEffectLabel}}</p>
			{{/if}}
			{{#if guided}}
			<p class="move-roll-guided-note">{{guided}}: use the "Take 7-9" button below to skip rolling.</p>
			{{/if}}
		</div>
		<div class="move-roll-column-2">
			<h3 class="move-roll-column-header">Equipment &amp; Modifiers</h3>
			{{#if narrativeTags.length}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Tags</label>
				<div class="equipment-tags-block"><ul class="equipment-tag-list">
					{{#each narrativeTags}}
					<li class="equipment-tag"><span class="equipment-tag-label">{{equipmentName}} — {{tagLabel}}{{#if showValue}} ({{value}}){{/if}}</span><span class="equipment-tag-description">{{description}}</span></li>
					{{/each}}
				</ul></div>
			</div>
			{{/if}}
			{{#if rerollTag}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Reroll</label>
				<div class="equipment-tags-block"><ul class="equipment-tag-list">
					<li class="equipment-tag"><span class="equipment-tag-label">{{rerollTag.tagLabel}}</span><span class="equipment-tag-description">{{rerollTag.description}}</span></li>
				</ul></div>
			</div>
			{{/if}}
			{{#if equipmentSpends.length}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Equipment</label>
				<div class="move-roll-equipment-list">
					{{#each equipmentSpends}}
					<div class="move-roll-equipment-spend{{#if disabled}} disabled{{/if}}">
						<label class="move-roll-equipment-spend-option">
							<input type="checkbox" name="equipment-tag" value="{{equipmentId}}::{{tagKey}}" {{#if disabled}}disabled{{/if}}/>
							<span class="move-roll-equipment-name">{{equipmentName}} — {{tagLabel}}</span>
						</label>
						<div class="move-roll-equipment-description">{{description}}</div>
					</div>
					{{/each}}
				</div>
			</div>
			{{/if}}
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Roll Modifiers</label>
				{{#if rollModifiers.length}}
				<div class="move-roll-equipment-list">
					{{#each rollModifiers}}
					<div class="move-roll-equipment-spend{{#if disabled}} disabled{{/if}}" data-roll-modifier-row="{{key}}">
						<label class="move-roll-equipment-spend-option">
							{{#unless reminderOnly}}
							<input type="checkbox" name="roll-modifier"
							       value="{{key}}" {{#if forced}}checked disabled{{else}}{{#if disabled}}disabled{{/if}}{{/if}}/>
							{{/unless}}
							<span class="move-roll-equipment-name">{{label}}</span>
							{{#if forced}}<span class="move-roll-modifier-deferred-note">(automatic)</span>{{/if}}
						</label>
						<div class="move-roll-equipment-description">{{{description}}}</div>
						<div class="move-roll-modifier-reason" data-roll-modifier-reason>{{disabledReason}}</div>
					</div>
					{{/each}}
				</div>
				{{else}}
				<p class="move-roll-list-section-empty">There are no roll modifiers for this roll.</p>
				{{/if}}
			</div>
			<div class="form-group move-roll-equipment move-roll-list-section">
				<label>Riders</label>
				{{#if riders.length}}
				<div class="move-roll-equipment-list">
					{{#each riders}}
					<div class="move-roll-equipment-spend">
						<span class="move-roll-equipment-name">{{label}}</span>
						<div class="move-roll-equipment-description">{{text}}</div>
					</div>
					{{/each}}
				</div>
				{{else}}
				<p class="move-roll-list-section-empty">There are no riders for this roll.</p>
				{{/if}}
			</div>
		</div>
	</div>
{{/if}}
</form>
