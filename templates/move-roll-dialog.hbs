<form class="armor-astir-move-roll-dialog">
	{{#if traits.length}}
	<div class="form-group">
		<label>Trait</label>
		<select name="trait">
			{{#each traits}}
			<option value="{{key}}">{{label}} ({{value}})</option>
			{{/each}}
		</select>
	</div>
	{{/if}}
	{{#if intents}}
	<div class="form-group">
		<label>Intent</label>
		<select name="intent">
			{{#each intents}}
			<option value="{{key}}">{{label}}</option>
			{{/each}}
		</select>
	</div>
	{{/if}}
	{{#if conditions}}
	<div class="form-group move-roll-conditions">
		<label>Conditions</label>
		<div class="move-roll-conditions-list">
			{{#each conditions}}
			<label class="move-roll-condition">
				<input type="checkbox" name="condition" value="{{key}}"/> {{label}}
			</label>
			{{/each}}
		</div>
	</div>
	{{/if}}
	<div class="form-group">
		<label>Dice</label>
		<select name="advantage">
			{{selectOptions advantageStates valueAttr="key" labelAttr="label"}}
		</select>
	</div>
	<div class="form-group">
		<label>Effect</label>
		<select name="effect" {{#if lockedEffect}}disabled{{/if}}>
			{{selectOptions effectStates selected=lockedEffect valueAttr="key" labelAttr="label"}}
		</select>
	</div>
	{{#if lockedEffect}}
	<p class="move-roll-locked-note">Locked: Desperation — max Perils</p>
	{{/if}}
</form>
