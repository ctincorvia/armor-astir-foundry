<form class="armor-astir-move-roll-dialog">
	<div class="form-group">
		<label>Trait</label>
		<select name="trait">
			{{#each traits}}
			<option value="{{key}}">{{label}} ({{value}})</option>
			{{/each}}
		</select>
	</div>
	<div class="form-group">
		<label>Dice</label>
		<select name="advantage">
			{{selectOptions advantageStates valueAttr="key" labelAttr="label"}}
		</select>
	</div>
	<div class="form-group">
		<label>Effect</label>
		<select name="effect">
			{{selectOptions effectStates valueAttr="key" labelAttr="label"}}
		</select>
	</div>
</form>
