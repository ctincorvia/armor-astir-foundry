<div class="tab" data-group="primary" data-tab="moves">
	<div class="section-header">
		<h3>Moves</h3>
		<div class="section-header-actions">
			<button type="button" class="npc-move-add icon-add-button" title="Add a Move" aria-label="Add a Move">+</button>
		</div>
	</div>
	<ol class="move-list">
		{{#each moves}}
		<li class="move">
			<span class="move-name">{{name}}</span>
			<div class="move-row-controls">
				<button type="button" class="move-description" data-move="{{key}}" aria-label="Post {{name}} to chat">Chat</button>
				<button type="button" class="move-info" data-move="{{key}}" aria-label="{{name}} rules text">?</button>
				<button type="button" class="npc-move-remove" data-move="{{key}}" aria-label="Remove move">✕</button>
			</div>
		</li>
		{{/each}}
	</ol>
</div>
