<div class="armor-astir-downtime-scene-chat">
	<h3 class="downtime-scene-chat-name">{{name}}</h3>
	<section class="downtime-scene-you">
		<h4>You</h4>
		<p>{{you}}</p>
	</section>
	<section class="downtime-scene-everyone">
		<h4>Anyone may spend a token to choose one:</h4>
		<ul class="downtime-scene-bullet-list">
			{{#each everyoneElse}}
			<li>{{text}}{{#if subBullets.length}}
				<ul class="downtime-scene-bullet-list downtime-scene-sub-bullet-list">
					{{#each subBullets}}<li>{{this}}</li>{{/each}}
				</ul>
			{{/if}}</li>
			{{/each}}
		</ul>
	</section>
	{{#if note}}
	<p class="downtime-scene-note">{{note}}</p>
	{{/if}}
</div>
