<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="form-group">
			<label>Name</label>
			<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
		</div>
	</header>
	<section class="factions">
		<div class="section-header">
			<h3>Factions ({{factions.length}})</h3>
			<div class="section-header-actions">
				<button type="button" class="entry-list-add icon-add-button" data-list="factions" title="Add Faction" aria-label="Add Faction">+</button>
			</div>
		</div>
		<ol class="entry-list faction-list">
			{{#each factions}}
			<li class="entry-list-item {{#if exhausted}}faction-exhausted{{/if}}" data-entry-id="{{id}}">
				<div class="entry-list-row">
					<input type="text" class="entry-list-field faction-name" data-list="factions" data-entry-id="{{id}}" data-field="name" value="{{name}}" placeholder="Faction name"/>
					<label class="faction-exhausted-label">
						<input type="checkbox" class="entry-list-field" data-list="factions" data-entry-id="{{id}}" data-field="exhausted" {{#if exhausted}}checked{{/if}}/>
						Exhausted
					</label>
					<button type="button" class="entry-list-remove" data-list="factions" data-entry-id="{{id}}" aria-label="Remove faction">✕</button>
				</div>
				<textarea class="entry-list-field faction-description" data-list="factions" data-entry-id="{{id}}" data-field="description" placeholder="Brief description…">{{description}}</textarea>
			</li>
			{{/each}}
		</ol>
	</section>
</form>
