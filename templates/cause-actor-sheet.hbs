<form class="{{cssClass}}" autocomplete="off">
	<header class="sheet-header">
		<img class="profile-img" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}"/>
		<div class="form-group">
			<label>Name</label>
			<input type="text" name="name" value="{{actor.name}}" placeholder="Name"/>
		</div>
	</header>
	<section class="factions">
		<div class="section-header">
			<h3>Factions ({{factions.length}})</h3>
			<div class="section-header-actions">
				<button type="button" class="entry-list-add icon-add-button" data-list="factions" title="Add Faction" aria-label="Add Faction">+</button>
			</div>
		</div>
		<ol class="entry-list faction-list">
			{{#each factions}}
			{{> "modules/armor-astir/templates/cause-sheet/faction-card.hbs" listKey="factions"}}
			{{/each}}
		</ol>
	</section>
	<section class="wayward-factions">
		<div class="section-header">
			<h3>Wayward Factions ({{waywardFactions.length}})</h3>
			<div class="section-header-actions">
				<button type="button" class="entry-list-add icon-add-button" data-list="waywardFactions" title="Add Wayward Faction" aria-label="Add Wayward Faction">+</button>
			</div>
		</div>
		<ol class="entry-list wayward-faction-list">
			{{#each waywardFactions}}
			{{> "modules/armor-astir/templates/cause-sheet/faction-card.hbs" listKey="waywardFactions"}}
			{{/each}}
		</ol>
	</section>
</form>
